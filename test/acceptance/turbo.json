{
  "extends": ["//"],
  "tags": ["verification"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "//#toolchain:prepare"],
      "inputs": [],
      "outputs": ["dist/**"],
      "cache": false,
      "tags": ["work:preparation"]
    },
    "conformance": {
      "dependsOn": ["build", "^build", "//#toolchain:prepare"],
      "passThroughEnv": [
        "INIT_CWD",
        "TSSAE_CONFORMANCE_CWD",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY",
        "http_proxy",
        "https_proxy",
        "no_proxy",
        "XDG_CACHE_HOME",
        "CARGO_NET_OFFLINE",
        "TSSAE_ACCEPTANCE_PACK_DIR",
        "TSSAE_CORPUS_CACHE_DIR",
        "TSSAE_CORPUS_HOST_MIRROR_DIR"
      ],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "cache": false,
      "tags": ["work:on-demand"]
    },
    "format:check": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "lint:fix": {
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "perf": {
      "dependsOn": ["build", "^build", "//#toolchain:prepare"],
      "passThroughEnv": [
        "INIT_CWD",
        "TSSAE_PERF_CWD",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY",
        "http_proxy",
        "https_proxy",
        "no_proxy",
        "XDG_CACHE_HOME",
        "CARGO_NET_OFFLINE",
        "TSSAE_ACCEPTANCE_PACK_DIR",
        "TSSAE_PERF_CACHE_DIR",
        "TSSAE_CORPUS_CACHE_DIR",
        "TSSAE_CORPUS_HOST_MIRROR_DIR"
      ],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "cache": false,
      "tags": ["work:on-demand"]
    },
    "perf:gate": {
      "dependsOn": ["build", "^build", "//#toolchain:prepare", "test:e2e"],
      "passThroughEnv": [
        "INIT_CWD",
        "TSSAE_PERF_CWD",
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY",
        "http_proxy",
        "https_proxy",
        "no_proxy",
        "XDG_CACHE_HOME",
        "CARGO_NET_OFFLINE",
        "TSSAE_ACCEPTANCE_PACK_DIR",
        "TSSAE_PERF_CACHE_DIR",
        "TSSAE_CORPUS_CACHE_DIR",
        "TSSAE_CORPUS_HOST_MIRROR_DIR"
      ],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "cache": false,
      "tags": ["quality:heavy"]
    },
    "test": {
      "dependsOn": ["@tssae/test-hosts#build", "^typecheck"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "test:e2e": {
      "dependsOn": ["build", "^build", "//#toolchain:prepare"],
      "passThroughEnv": [
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY",
        "http_proxy",
        "https_proxy",
        "no_proxy",
        "XDG_CACHE_HOME",
        "CARGO_NET_OFFLINE",
        "TSSAE_ACCEPTANCE_PACK_DIR"
      ],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "cache": false,
      "tags": ["quality:heavy"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "tags": ["quality:light"]
    }
  }
}
