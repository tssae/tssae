{
  "extends": ["//"],
  "tags": ["library"],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "@tssae/adapter-api#build",
        "//#toolchain:prepare"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "native/zod/Cargo.toml",
        "native/zod/Cargo.lock",
        "native/zod/tssae-native.json",
        "native/zod/src/**",
        "native/drizzle/Cargo.toml",
        "native/drizzle/Cargo.lock",
        "native/drizzle/tssae-native.json",
        "native/drizzle/src/**"
      ],
      "outputs": ["dist/**"],
      "cache": false,
      "tags": ["work:preparation"]
    },
    "format:check": {
      "dependsOn": ["//#toolchain:prepare"],
      "inputs": ["$TURBO_DEFAULT$", "!native/*/target/**"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "format:write": {
      "dependsOn": ["lint:fix", "//#toolchain:prepare"],
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "lint": {
      "dependsOn": ["^lint", "//#toolchain:prepare"],
      "inputs": ["$TURBO_DEFAULT$", "!native/*/target/**"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "lint:fix": {
      "dependsOn": ["//#toolchain:prepare"],
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "test": {
      "dependsOn": ["^build", "build", "//#toolchain:prepare"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "native/zod/Cargo.toml",
        "native/zod/Cargo.lock",
        "native/zod/tssae-native.json",
        "native/zod/src/**",
        "native/drizzle/Cargo.toml",
        "native/drizzle/Cargo.lock",
        "native/drizzle/tssae-native.json",
        "native/drizzle/src/**",
        "!native/*/target/**"
      ],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "typecheck": {
      "dependsOn": ["tssae#typecheck", "@tssae/test-hosts#typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!native/*/target/**"],
      "outputs": [],
      "tags": ["quality:light"]
    }
  }
}
