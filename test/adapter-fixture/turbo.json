{
  "extends": ["//"],
  "tags": ["verification"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "//#toolchain:prepare"],
      "inputs": [],
      "outputs": ["dist/**"],
      "cache": false,
      "tags": ["work:preparation"]
    },
    "format:check": {
      "dependsOn": ["//#toolchain:prepare"],
      "inputs": ["$TURBO_DEFAULT$", "!native/target/**"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "format:write": {
      "dependsOn": ["lint:fix", "//#toolchain:prepare"],
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "lint": {
      "dependsOn": ["^lint", "//#toolchain:prepare"],
      "inputs": ["$TURBO_DEFAULT$", "!native/target/**"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "lint:fix": {
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "test": {
      "dependsOn": ["^build", "build", "@verule/test-hosts#typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!native/target/**"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "typecheck": {
      "dependsOn": ["tssae#typecheck", "@verule/test-hosts#typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!native/target/**"],
      "outputs": [],
      "tags": ["quality:light"]
    }
  }
}
