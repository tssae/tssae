{
  "extends": ["//"],
  "tags": ["tooling"],
  "tasks": {
    "build": {
      "dependsOn": ["//#toolchain:prepare"],
      "inputs": [],
      "outputs": ["target/**", "dist/**"],
      "cache": false,
      "tags": ["work:preparation"]
    },
    "format:check": {
      "dependsOn": ["//#toolchain:prepare"],
      "inputs": ["$TURBO_DEFAULT$", "!target/**"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "format:write": {
      "dependsOn": ["lint:fix", "//#toolchain:prepare"],
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "lint": {
      "dependsOn": ["//#toolchain:prepare"],
      "inputs": ["$TURBO_DEFAULT$", "!target/**"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "lint:fix": {
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "test": {
      "dependsOn": ["//#toolchain:prepare"],
      "inputs": ["$TURBO_DEFAULT$", "!target/**"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "typecheck": {
      "dependsOn": ["@tssae/tooling-config#typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!target/**"],
      "outputs": [],
      "tags": ["quality:light"]
    }
  }
}
