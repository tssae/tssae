{
  "extends": ["//"],
  "tags": ["native"],
  "tasks": {
    "build": {
      "dependsOn": ["//#toolchain:prepare"],
      "inputs": [],
      "outputs": ["dist/**"],
      "cache": false,
      "tags": ["quality:light"]
    },
    "format:check": {
      "dependsOn": ["//#toolchain:prepare"],
      "inputs": ["$TURBO_DEFAULT$", "!target/**"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "format:write": {
      "dependsOn": ["//#toolchain:prepare"],
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "lint": {
      "dependsOn": [
        "//#toolchain:prepare",
        "^lint",
        "@verule/test-hosts#typecheck"
      ],
      "inputs": ["$TURBO_DEFAULT$", "!target/**"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "test": {
      "dependsOn": ["//#toolchain:prepare", "@verule/test-hosts#typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!target/**"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "typecheck": {
      "dependsOn": ["@verule/test-hosts#typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "!target/**"],
      "outputs": [],
      "tags": ["quality:light"]
    }
  }
}
