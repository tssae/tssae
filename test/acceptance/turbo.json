{
  "extends": ["//"],
  "tags": ["verification"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "//#toolchain:prepare"],
      "inputs": [],
      "outputs": ["dist/**"],
      "cache": false,
      "tags": ["work:preparation"]
    },
    "format:check": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "lint:fix": {
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "test": {
      "dependsOn": ["@tssae/test-hosts#build", "^typecheck"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "test:e2e": {
      "dependsOn": ["build", "^build", "//#toolchain:prepare"],
      "passThroughEnv": [
        "HTTP_PROXY",
        "HTTPS_PROXY",
        "NO_PROXY",
        "http_proxy",
        "https_proxy",
        "no_proxy",
        "XDG_CACHE_HOME",
        "CARGO_NET_OFFLINE",
        "TSSAE_ACCEPTANCE_PACK_DIR",
        "TSSAE_ACCEPTANCE_CRATE_PATH"
      ],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "cache": false,
      "tags": ["quality:heavy"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [],
      "tags": ["quality:light"]
    }
  }
}
