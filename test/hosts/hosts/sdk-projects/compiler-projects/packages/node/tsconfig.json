{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "strict": false,
    "strictNullChecks": true,
    "allowJs": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@runtime": ["./src/node.ts"],
      "ext-lib": [
        "../../node_modules/ext-lib/index.d.ts",
        "../../deps/ext-lib/index.d.ts"
      ]
    }
  },
  "include": ["src/**/*.ts", "../shared/shared.ts"]
}
