{
  "editor.codeActionsOnSave": {
    "source.format.oxc": "always",
    "source.fixAll.oxc": "always"
  },
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "oxc.configPath": "./oxlint.config.ts",
  "oxc.enable": true,
  "oxc.fmt.configPath": "./oxfmt.config.ts",
  "rust-analyzer.cargo.features": "all",
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.linkedProjects": [
    "./packages/engine/Cargo.toml",
    "./packages/adapter-api/Cargo.toml",
    "./adapters/zod/native/Cargo.toml",
    "./adapters/drizzle/native/Cargo.toml",
    "./test/adapter-fixture/native/Cargo.toml",
    "./test/adapter-fixture-complement/native/Cargo.toml"
  ],
  "rust-analyzer.procMacro.enable": true
}
